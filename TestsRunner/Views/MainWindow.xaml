<Window x:Class="TestsRunner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TestsRunner.Converters"
        xmlns:viewModels="clr-namespace:TestsRunner.ViewModels.Implementations"
        mc:Ignorable="d"
        Title="Test Runner" Height="450" Width="899"
        Background="#F5F0FF">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryPurple" Color="#8A2BE2"/>
        <SolidColorBrush x:Key="LightPurple" Color="#E6D9FF"/>
        <SolidColorBrush x:Key="VeryLightPurple" Color="#F0E6FF"/>
        <SolidColorBrush x:Key="White" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkPurple" Color="#4B0082"/>

        <converters:StatusToImageConverter x:Key="StatusToImageConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:TimeSpanToVisibilityConverter x:Key="TimeSpanToVisibilityConverter"/>

        <Style x:Key="PurpleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="25,8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkPurple}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Шаблон для метода (может содержать дочерние TestCase) -->
        <HierarchicalDataTemplate DataType="{x:Type viewModels:MethodViewModel}" 
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2" ToolTip="{Binding ToolTip}">
                <Image Source="{Binding Status, Converter={StaticResource StatusToImageConverter}}" 
               Width="16" Height="16" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DisplayString}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ToolTip}" 
                  Margin="10,0,0,0" 
                  Foreground="Gray" 
                  FontSize="11" 
                  VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Шаблон для TestCase (для параметризованных тестов) -->
        <DataTemplate DataType="{x:Type viewModels:TestCaseViewModel}">
            <StackPanel Orientation="Horizontal" Margin="2,2,2,2" ToolTip="{Binding ToolTip}">
                <Image Source="{Binding Status, Converter={StaticResource StatusToImageConverter}}" 
               Width="14" Height="14" Margin="20,0,5,0"/>
                <TextBlock Text="{Binding DisplayName}" 
                  VerticalAlignment="Center" 
                  FontStyle="Italic"
                  Foreground="#4B0082"/>
                <TextBlock Text="{Binding ToolTip}" 
                  Margin="10,0,0,0" 
                  Foreground="Gray" 
                  FontSize="11" 
                  VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Шаблон для класса -->
        <HierarchicalDataTemplate DataType="{x:Type viewModels:ClassViewModel}" 
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Image Source="{Binding Status, Converter={StaticResource StatusToImageConverter}}" 
                       Width="16" Height="16" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Шаблон для сборки -->
        <HierarchicalDataTemplate DataType="{x:Type viewModels:AssemblyViewModel}" 
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Image Source="{Binding Status, Converter={StaticResource StatusToImageConverter}}" 
                       Width="16" Height="16" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#4B0082"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="FilterTemplate">
            <Border Background="{StaticResource VeryLightPurple}"
                CornerRadius="5"
                Padding="10,5"
                Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource DarkPurple}"
                           FontSize="11"
                           Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding PossibleValues}"
                          SelectedItem="{Binding SelectedValue}"
                          IsEnabled="{Binding DataContext.IsFilterEnabled, 
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Background="{StaticResource White}"
                          BorderBrush="{StaticResource LightPurple}"
                          Foreground="{StaticResource DarkPurple}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Стиль для TreeView -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightPurple}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Стиль для элемента TreeView -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightPurple}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource VeryLightPurple}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
        Background="{StaticResource White}" 
        Padding="15,10"
        BorderBrush="{StaticResource LightPurple}"
        BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопки слева -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Загрузить сборку" 
                    Style="{StaticResource PurpleButtonStyle}"
                    Command="{Binding LoadAssemblyCommand}"
                    ToolTip="Загрузить новую тестовую сборку"/>

                    <Button Content="Удалить сборку" 
                    Style="{StaticResource PurpleButtonStyle}"
                    Command="{Binding DeleteAssemblyCommand}"
                    ToolTip="Удалить выбранную сборку"/>

                    <Button Content="Запуск тестов" 
                    Style="{StaticResource PurpleButtonStyle}"
                    Command="{Binding RunSelectedTestsCommand}"
                    ToolTip="Запустить выбранные тесты"/>

                    <!-- Отображение времени выполнения -->
                    <Border Background="{Binding IsRunning, Converter={StaticResource BoolToColorConverter}}"
                    CornerRadius="5"
                    Padding="10,5"
                    Margin="10,0,0,0"
                    Visibility="{Binding TotalExecutionTime, Converter={StaticResource TimeSpanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱️" 
                              FontSize="16" 
                              Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding TotalExecutionTimeDisplay}" 
                              VerticalAlignment="Center"
                              Foreground="{StaticResource DarkPurple}"
                              FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- Статистика справа -->
                <StackPanel Grid.Column="1" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    Margin="10,0">

                    <!-- Разделитель -->
                    <Rectangle Width="2" 
                      Fill="{StaticResource LightPurple}" 
                      Margin="0,0,15,0"/>

                    <!-- Общая статистика -->
                    <Border Background="{StaticResource VeryLightPurple}"
                    CornerRadius="5"
                    Padding="15,5">
                        <StackPanel Orientation="Horizontal">
                            <!-- Всего тестов -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                <TextBlock Text="Всего: "
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource DarkPurple}"
                                  FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalTests}"  
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource DarkPurple}"
                                  FontWeight="Bold"
                                  FontSize="16"
                                  Margin="3,0"/>
                            </StackPanel>

                            <!-- Вертикальный разделитель -->
                            <Rectangle Width="1" 
                              Fill="{StaticResource LightPurple}" 
                              Margin="0,2,15,2"/>

                            <!-- Пройдено -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                <Image Source="../Images/test_passed.png" 
                               Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding PassedTests}" 
                                  VerticalAlignment="Center"
                                  Foreground="Green"
                                  FontWeight="Bold"
                                  FontSize="16"
                                  Margin="3,0"/>
                            </StackPanel>

                            <!-- Не пройдено -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                <Image Source="../Images/test_failed.png" 
                               Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding FailedTests}" 
                                  VerticalAlignment="Center"
                                  Foreground="Red"
                                  FontWeight="Bold"
                                  FontSize="16"
                                  Margin="3,0"/>
                            </StackPanel>

                            <!-- Пропущено -->
                            <StackPanel Orientation="Horizontal">
                                <Image Source="../Images/test_none.png" 
                               Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding SkippedTests}"
                                  VerticalAlignment="Center"
                                  Foreground="Blue"
                                  FontWeight="Bold"
                                  FontSize="16"
                                  Margin="3,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Информация о выбранных тестах -->
                    <Border Background="{StaticResource LightPurple}"
                    CornerRadius="5"
                    Padding="15,5"
                    Margin="10,0,0,0">
                        <TextBlock Text="{Binding SelectedCountText}" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource DarkPurple}"
                          FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Область с деревом тестов -->
        <Grid Grid.Row="1" Background="#F0E6FF">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0" 
                      x:Name="TestTreeView"
                      ItemsSource="{Binding CurrentTestAssemblies}"
                      SelectedItemChanged="TestTreeView_SelectedItemChanged"
                      Background="White"
                      BorderBrush="#E6D9FF"
                      BorderThickness="1"
                      Margin="10"/>
            <!-- Боковая панель -->
            <ScrollViewer Grid.Column="1" 
               VerticalScrollBarVisibility="Auto"
               Background="{StaticResource VeryLightPurple}">
                <StackPanel Margin="10">

                    <Border Background="{StaticResource PrimaryPurple}"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,0,0,10">
                        <TextBlock Text="Параллелизм"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </Border>
                    <CheckBox Content="Включить"
                                      IsChecked="{Binding IsParallelExecutionEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="10"/>
                    <!-- Панель управления параллелизмом (центр) -->
                    <Border Background="{StaticResource VeryLightPurple}"
                            CornerRadius="5"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Min " 
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource DarkPurple}"
                                       Padding="5"/>
                            <Button Content="-"
                                    Width="25"
                                    Height="25"
                                    Command="{Binding DecreaseMinParallelismCommand}"
                                    Background="{StaticResource LightPurple}"
                                    BorderThickness="0"
                                    Margin="2"/>

                            <TextBlock Text="{Binding MinParallelism}"
                                       Width="30"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>

                            <Button Content="+"
                                    Width="25"
                                    Height="25"
                                    Command="{Binding IncreaseMinParallelismCommand}"
                                    Background="{StaticResource LightPurple}"
                                    BorderThickness="0"
                                    Margin="2"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource VeryLightPurple}"
                            CornerRadius="5"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Max " 
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource DarkPurple}"
                                       Padding="5"/>
                            <Button Content="-"
                                    Width="25"
                                    Height="25"
                                    Command="{Binding DecreaseMaxParallelismCommand}"
                                    Background="{StaticResource LightPurple}"
                                    BorderThickness="0"
                                    Margin="2"/>

                            <TextBlock Text="{Binding MaxParallelism}"
                                       Width="30"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>

                            <Button Content="+"
                                    Width="25"
                                    Height="25"
                                    Command="{Binding IncreaseMaxParallelismCommand}"
                                    Background="{StaticResource LightPurple}"
                                    BorderThickness="0"
                                    Margin="2"/>
                        </StackPanel>
                    </Border>

                    <!-- Заголовок боковой панели -->
                    <Border Background="{StaticResource PrimaryPurple}"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,0,0,10">
                        <TextBlock Text="📊 Состояние пула потоков"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </Border>

                    <!-- Статистика пула потоков -->
                    <Border Background="{StaticResource White}"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Статистика"
                     FontWeight="Bold"
                     FontSize="13"
                     Foreground="{StaticResource DarkPurple}"
                     Margin="0,0,0,10"/>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Всего потоков:" Foreground="#555"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ThreadPoolStats.TotalThreads}" FontWeight="Bold" Foreground="{StaticResource DarkPurple}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Задач в очереди:" Foreground="#555"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThreadPoolStats.QueuedTasks}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource DarkPurple}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThreadPoolStats.QueuedTasks}" Value="0">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ThreadPoolStats.QueuedTasks}" Value="0">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Мин. потоков:" Foreground="#555"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ThreadPoolStats.MinThreads}" FontWeight="Bold" Foreground="{StaticResource DarkPurple}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Макс. потоков:" Foreground="#555"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ThreadPoolStats.MaxThreads}" FontWeight="Bold" Foreground="{StaticResource DarkPurple}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Список ошибок -->
                    <Border Background="{StaticResource White}"
                 CornerRadius="5"
                 Padding="10"
                 Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ошибки пула потоков"
                                FontWeight="Bold"
                                FontSize="13"
                                Foreground="{StaticResource DarkPurple}"/>
                                <Button Grid.Column="1"
                             Content="Очистить"
                             Command="{Binding ClearThreadPoolErrorsCommand}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource PrimaryPurple}"
                             Cursor="Hand"
                             FontSize="11"/>
                            </Grid>

                            <!-- Список ошибок -->
                            <ListBox ItemsSource="{Binding ThreadPoolErrors}"
                          SelectedItem="{Binding SelectedThreadPoolError}"
                          MaxHeight="300"
                          Background="{StaticResource VeryLightPurple}"
                          BorderBrush="{StaticResource LightPurple}"
                          BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LightPurple}"
                                     BorderThickness="0,0,0,1"
                                     Padding="8,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}"
                                                TextWrapping="Wrap"
                                                FontSize="11"
                                                Foreground="{StaticResource DarkPurple}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                    FontSize="9"
                                                    Foreground="#888"/>
                                                    <TextBlock Text=" | "
                                                    FontSize="9"
                                                    Foreground="#888"/>
                                                    <TextBlock Text="{Binding ThreadName}"
                                                    FontSize="9"
                                                    Foreground="{StaticResource PrimaryPurple}"
                                                    FontStyle="Italic"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Фильтр тестов -->
                    <Border Background="{StaticResource White}"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Фильтр тестов"
                            FontWeight="Bold"
                            FontSize="13"
                            Foreground="{StaticResource DarkPurple}"
                            Margin="0,0,0,10"/>

                            <!-- Чекбокс включения фильтра -->
                            <CheckBox Content="Включить фильтрацию"
                            IsChecked="{Binding FiltersViewModel.IsFiltersEnabled}"
                            Margin="0,0,0,10"
                            Foreground="{StaticResource DarkPurple}"/>

                            <!-- Комбобокс категорий (активен только при включенном фильтре) -->
                            <Border Background="{StaticResource VeryLightPurple}"
                            CornerRadius="5"
                            Padding="10,5">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding FiltersViewModel.Filters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding}" 
                              ContentTemplate="{StaticResource FilterTemplate}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Дополнительная информация о количестве тестов -->
                                    <TextBlock Margin="0,5,0,0"
                                    FontSize="10"
                                    Foreground="#888">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilterEnabled}" Value="True">
                                                        <Setter Property="Text" Value="{Binding FilteredTestsCount, StringFormat='Найдено тестов: {0}'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>